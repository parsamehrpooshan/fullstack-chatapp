# Copy this file to .env and fill in the values. .env is gitignored.

# HTTP + WebSocket port.
PORT=4000

# Token signing key. REQUIRED — the server refuses to start without it and has
# no in-code fallback. Use a long, random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# CORS allowed origin: the client dev server's URL.
CLIENT_URL=http://localhost:3000
